  "knownGaps": [
    {
      "area": "places",
      "text": "The Mediterranean, the Dead Sea, and Samaria aren't central to Matthew's story; they're pulled to draw the map. Egypt is off the map."
    },
    {
      "area": "people",
      "text": "Theographic has no records for the magi, the devil, or groups like the Pharisees and Sadducees. Those stay hand-written."
    },
    {
      "area": "chapters",
      "text": "Chapters 10 to 28 have text, people, places, and cross-references from the data, but no hand-written context notes yet."
    },
    {
      "area": "words",
      "text": "Emmanouel appears only once in the New Testament; its other uses (Isaiah 7:14, 8:8) are in the Hebrew Bible, which the Greek tagging doesn't cover."
    },
    {
      "area": "places",
      "text": "Manuscripts differ at 8:28 (Gadarenes, Gerasenes, or Gergesenes), so where the pigs scene happened is debated; we show Gadara as OpenBible locates it."
    }
  ]
